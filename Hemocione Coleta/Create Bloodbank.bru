meta {
  name: Create Bloodbank
  type: http
  seq: 1
}

post {
  url: {{url}}/backoffice/v1/bloodbanks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  x-secret: {{secret}}
}

body:json {
  {
    "name": "HEMORIO",
    "logo": "https://cdn.hemocione.com.br/events/prod/uploads/private/3b2fc4ec-ac6b-477c-b61e-baec5df9535a/1760991375815-hemorio.png",
    "bloodBanksLocationId": "35ebcebf-d99a-48da-8cc6-9eab794ed83a",
    "timezone": "America/Sao_Paulo"
  }
}

settings {
  encodeUrl: false
  timeout: 0
}
